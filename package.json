{
  "name": "@naskot/node-hmac-auth-management",
  "version": "0.1.0",
  "description": "Stateful orchestration layer on top of @naskot/node-hmac-auth: probe, bootstrap, propagate, retry, rollback. The consumer drives a CRUD; the lib is the worker.",
  "repository": {
    "type": "git",
    "url": "https://github.com/padcmoi/node-hmac-auth-management"
  },
  "homepage": "https://github.com/padcmoi/node-hmac-auth-management",
  "bugs": {
    "url": "https://github.com/padcmoi/node-hmac-auth-management/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "dev:test": "vitest",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "hmac",
    "auth",
    "management",
    "propagation",
    "orchestration",
    "control-plane"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@naskot/node-hmac-auth": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@naskot/node-hmac-auth": "^1.3.0",
    "@types/node": "^24.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  }
}
