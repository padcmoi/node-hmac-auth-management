# Default values for the embedded mariadb service shipped in docker-compose.yml.
# Copy this file to `.env` to use it as-is, or override with real credentials
# pointing at an external MariaDB.
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=rootpwd
MARIADB_DATABASE=hmac_mgmt
MARIADB_USER=hmac
MARIADB_PASSWORD=hmacpwd
